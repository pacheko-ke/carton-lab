      "label": "Ear notch width",
      "default": 20,
      "min": 0
    }
  ],
  "params": {
    "refL": "830",
    "refW": "345",
    "refH": "170",
    "kL": "L / refL",
    "kW": "W / refW",
    "kH": "H / refH",
    "pr": "min(kW, kH)",
    "ec": "ex + lug + H",
    "xl": "ec",
    "xr": "ec + L",
    "xwr": "xr + H",
    "bl": "xwr + lug + ex",
    "bw": "W + 2*H",
    "yf": "H + W",
    "yw": "H - ex",
    "ywb": "yf + ex",
    "yc": "H + W / 2",
