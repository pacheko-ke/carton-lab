      "d": "M{lugW + chOut} {0} L{lugW} {H} L{lugW} {lugGapY} L{lugEdge} {lugEdgeY} L{lugIn} {lugInY} A{lugR} {lugR} 0 0 0 {0} {lugTop} L{0} {lugBot} L{lugW} {lugBot} L{lugW} {stepY} L{stepX} {stepY} L{stepX} {yc - mH - mR} A{mR} {mR} 0 0 0 {stepX + mR} {yc - mH} L{mEnd} {yc - mH} L{mEnd} {yc + mH} L{stepX + mR} {yc + mH} A{mR} {mR} 0 0 0 {stepX} {yc + mH + mR} L{stepX} {bw - (yc + mH + mR)} A{mR} {mR} 0 0 0 {stepX + mR} {bw - (yc + mH)} L{mEnd} {bw - (yc + mH)} L{mEnd} {bw - (yc - mH)} L{stepX + mR} {bw - (yc - mH)} A{mR} {mR} 0 0 0 {stepX} {bw - (yc - mH - mR)} L{stepX} {bw - (stepY)} L{lugW} {bw - (stepY)} L{lugW} {bw - (lugBot)} L{0} {bw - (lugBot)} L{0} {bw - (lugTop)} A{lugR} {lugR} 0 0 0 {lugIn} {bw - (lugInY)} L{lugEdge} {bw - (lugEdgeY)} L{lugW} {bw - (lugGapY)} L{lugW} {bw - (H)} L{lugW + chOut} {bw - (0)} L{lugW} {bw - H} L{lugW + chOut} {bw} L{cx - sl - chIn} {bw} L{cx - sl} {bw - H} L{cx - sl} {bw - slitD + sl} A{sl} {sl} 0 0 1 {cx + sl} {bw - slitD + sl} L{cx + sl} {bw - H} L{cx + sl + chIn} {bw} L{bl - (lugW + chOut)} {bw} L{bl - (lugW)} {bw - H} L{bl - (lugW + chOut)} {bw - (0)} L{bl - (lugW)} {bw - (H)} L{bl - (lugW)} {bw - (lugGapY)} L{bl - (lugEdge)} {bw - (lugEdgeY)} L{bl - (lugIn)} {bw - (lugInY)} A{lugR} {lugR} 0 0 0 {bl - (0)} {bw - (lugTop)} L{bl - (0)} {bw - (lugBot)} L{bl - (lugW)} {bw - (lugBot)} L{bl - (lugW)} {bw - (stepY)} L{bl - (stepX)} {bw - (stepY)} L{bl - (stepX)} {bw - (yc - mH - mR)} A{mR} {mR} 0 0 0 {bl - (stepX + mR)} {bw - (yc - mH)} L{bl - (mEnd)} {bw - (yc - mH)} L{bl - (mEnd)} {bw - (yc + mH)} L{bl - (stepX + mR)} {bw - (yc + mH)} A{mR} {mR} 0 0 0 {bl - (stepX)} {bw - (yc + mH + mR)} L{bl - (stepX)} {yc + mH + mR} A{mR} {mR} 0 0 0 {bl - (stepX + mR)} {yc + mH} L{bl - (mEnd)} {yc + mH} L{bl - (mEnd)} {yc - mH} L{bl - (stepX + mR)} {yc - mH} A{mR} {mR} 0 0 0 {bl - (stepX)} {yc - mH - mR} L{bl - (stepX)} {stepY} L{bl - (lugW)} {stepY} L{bl - (lugW)} {lugBot} L{bl - (0)} {lugBot} L{bl - (0)} {lugTop} A{lugR} {lugR} 0 0 0 {bl - (lugIn)} {lugInY} L{bl - (lugEdge)} {lugEdgeY} L{bl - (lugW)} {lugGapY} L{bl - (lugW)} {H} L{bl - (lugW + chOut)} {0} L{cx + sl + chIn} {0} L{cx + sl} {H} L{cx + sl} {slitD - sl} A{sl} {sl} 0 0 1 {cx - sl} {slitD - sl} L{cx - sl} {H} L{cx - sl - chIn} {0} Z"
