{
  "id": "chickenbox",
  "name": "Chicken Box s/f",
  "title": "CHICKEN BOX KEYLINE",
  "inputs": [
    {
      "id": "slit",
      "label": "Center slit width",
      "default": 4,
      "min": 0
    },
    {
      "id": "perfGap",
      "label": "Tear line spacing",
      "default": 2,
      "min": 0
    }
  ],
  "params": {
    "refL": "445.5",
    "refW": "330",
    "refH": "30",
    "kL": "L / refL",
    "kW": "W / refW",
    "kH": "H / refH",
    "pr": "min(kL, kW)",
    "lugW": "29.3",
    "sl": "slit / 2",
    "chOut": "20.3",
    "chIn": "30.6",
    "slitD": "123.6",
    "bl": "L + 2*lugW",
    "bw": "W + 2*H",
    "cx": "bl / 2",
    "yc": "bw / 2",
    "lugTop": "51.9",
    "lugBot": "119",
    "lugIn": "19.5",
    "lugInY": "54",
    "lugEdge": "22.8",
    "lugEdgeY": "72.6",
    "lugGapY": "73",
    "lugR": "9.8",
    "stepY": "158.8",
    "stepX": "lugW + 40",
    "mR": "6",
    "mH": "1.8",
    "mEnd": "79.7",
    "wW": "85.2",
    "wH": "83.2",
    "tipL": "15.4",
    "tipB": "6.5",
    "tipX": "cx - wW / 2 - tipL",
    "holeR": "7*pr",
    "holeP": "39*kL",
    "holeS": "20.5*kL",
    "holeX": "74*kL",
    "holeY1": "71.9*kW",
    "holeY2": "112.1*kW"
  },
  "require": [
    {
      "expr": "2*lugW + 2*(chOut) < L",
      "message": "The flaps do not fit this length."
    },
    {
      "expr": "slitD > H",
      "message": "The center slit is too short for this height."
    },
    {
      "expr": "holeX + 3*holeP + holeS + holeR < cx - sl",
      "message": "The holes do not fit this length."
    },
    {
      "expr": "holeY2 + holeR < yc - 20",
      "message": "The holes do not fit this height."
    },
    {
      "expr": "wH < W - 2*30",
      "message": "The window is too tall for this height."
    },
    {
      "expr": "wW / 2 + tipL < cx - mEnd",
      "message": "The window does not fit this length."
    }
  ],
  "cuts": [
    {
