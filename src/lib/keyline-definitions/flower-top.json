{
  "id": "f1top",
  "name": "F1 Zim Top - Machine Slotted Flower Box",
  "title": "ZIM TOP DIE SLOT KEYLINE",
  "inputs": [
    {
      "id": "notch",
      "label": "Notch size",
      "default": 10,
      "min": 0
    }
  ],
  "params": {
    "refL": "1040",
    "refW": "310",
    "refH": "200",
    "kL": "L / refL",
    "kW": "W / refW",
    "kH": "H / refH",
    "s2": "notch / 2",
    "ec": "H + s2",
    "xl": "ec",
    "xr": "ec + L",
    "bl": "L + 2*ec",
    "bw": "W + 2*H",
    "holeR": "40*min(kH, kW)",
    "hole1Y": "H + W / 4",
    "hole2Y": "H + 3*W / 4"
  },
  "require": [
    {
      "expr": "notch < L",
      "message": "The notch is too wide for this length."
    }
  ],
  "cuts": [
    {
      "id": "outline",
      "d": "M0 0 L{xl - s2} 0 L{xl - s2} {H} L{xl + s2} {H} L{xl + s2} 0 L{xr - s2} 0 L{xr - s2} {H} L{xr + s2} {H} L{xr + s2} 0 L{bl} 0 L{bl} {bw} L{xr + s2} {bw} L{xr + s2} {bw - H} L{xr - s2} {bw - H} L{xr - s2} {bw} L{xl + s2} {bw} L{xl + s2} {bw - H} L{xl - s2} {bw - H} L{xl - s2} {bw} L0 {bw} Z"
    },
    {
      "id": "side-hole-left-1",
      "type": "circle",
      "cx": "H / 2",
      "cy": "hole1Y",
      "r": "holeR"
    },
    {
      "id": "side-hole-left-2",
      "type": "circle",
      "cx": "H / 2",
      "cy": "hole2Y",
      "r": "holeR"
    },
    {
      "id": "side-hole-right-1",
      "type": "circle",
      "cx": "bl - H / 2",
      "cy": "hole1Y",
      "r": "holeR"
    },
    {
      "id": "side-hole-right-2",
      "type": "circle",
      "cx": "bl - H / 2",
      "cy": "hole2Y",
      "r": "holeR"
    }
  ],
  "creases": [
    {
      "d": "M0 {H} L{bl} {H}"
    },
    {
      "d": "M0 {H + W} L{bl} {H + W}"
    },
    {
      "d": "M{xl} {H} L{xl} {H + W}"
    },
    {
      "d": "M{xr} {H} L{xr} {H + W}"
    }
  ],
  "details": {
    "creasing": [
      "H",
      "W",
      "H"
    ],
    "boardLength": "bl",
    "boardWidth": "bw"
  }
}
