  "require": [
    {
      "expr": "ex < H",
      "message": "The wing overhang is too large for this height."
    },
    {
      "expr": "chX < ec",
      "message": "The corner cut is too wide for this height."
    },
    {
      "expr": "nOff + notch < ec",
      "message": "The notch does not fit this height."
    },
    {
      "expr": "holeD + earR < H - ex",
      "message": "The ear hole does not fit this height."
    },
    {
      "expr": "holeZ + earR < ec",
      "message": "The ear hole does not fit the ear width."
    },
    {
      "expr": "holeD + flapR < L / 2",
      "message": "The flap holes do not fit this length."
    },
    {
      "expr": "holeZ + flapR < H",
      "message": "The flap holes do not fit this height."
    },
    {
      "expr": "wingHx + wingR < H",
      "message": "The wing holes do not fit this height."
    },
    {
      "expr": "wingGap + 2*wingR < W + 2*ex",
      "message": "The wing holes do not fit this width."
    },
    {
      "expr": "2*bodyR < colStep",
      "message": "The body holes overlap at this length."
    },
    {
      "expr": "rowGap + 2*bodyR < W",
      "message": "The body holes do not fit this width."
    }
