generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id                   String            @id @default(cuid())
  name                 String?
  email                String?           @unique
  emailVerified        DateTime?
  image                String?
  premiumAccessGranted Boolean           @default(false)
  accounts             Account[]
  sessions             Session[]
  subscriptions        Subscription[]
  billingCheckouts     BillingCheckout[]
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  providerSubscriptionId String    @unique
  providerPlanId         String
  status                 String
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  providerEventCreatedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingCheckout {
  txRef                     String    @id
  userId                    String
  planId                    String
  paymentMethod             String    @default("card")
  amount                    Int       @default(5)
  currency                  String    @default("USD")
  exchangeRate              Float?
  rateDate                  DateTime?
  phoneNumber               String?
  providerCheckoutRequestId String?   @unique
  providerMerchantRequestId String?
  createdAt                 DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
