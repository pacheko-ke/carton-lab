generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                                  String                        @id @default(cuid())
  name                                String?
  companyName                         String?
  role                                String?
  contact                             String?
  address                             String?
  email                               String?                       @unique
  emailVerified                       DateTime?
  image                               String?
  premiumAccessGranted                Boolean                       @default(false)
  trialEndsAt                         DateTime?
  marketingEmailsEnabled              Boolean                       @default(true)
  marketingEmailsUpdatedAt            DateTime?
  accounts                            Account[]
  sessions                            Session[]
  subscriptions                       Subscription[]
  billingCheckouts                    BillingCheckout[]
  billingPayments                     BillingPayment[]
  keylineBookmarks                    KeylineBookmark[]
  emailJobs                           EmailJob[]
  companyMembership                   CompanyMembership?
  createdCompanyInvitations            CompanyInvitation[]            @relation("CompanyInvitationCreator")
  accessRoles                         UserAccessRole[]              @relation("AccessRoleUser")
  assignedAccessRoles                 UserAccessRole[]              @relation("AccessRoleAssignedBy")
  productionNotifications             ProductionNotification[]
  productionPushSubscriptions         ProductionPushSubscription[]
  createdProductionJobs               ProductionJob[]               @relation("ProductionJobCreator")
  createdProductionItems              ProductionItem[]              @relation("ProductionItemCreator")
  createdProductionCustomers          ProductionCustomer[]          @relation("ProductionCustomerCreator")
  createdProductionOperationSchedules ProductionOperationSchedule[] @relation("ProductionOperationScheduleCreator")
  createdProductionOperationRuns      ProductionOperationRun[]      @relation("ProductionOperationRunCreator")
  createdProductionQualityInspections ProductionQualityInspection[] @relation("ProductionQualityInspectionCreator")
  createdProductionNonconformances    ProductionNonconformance[]    @relation("ProductionNonconformanceCreator")
  updatedProductionNonconformances    ProductionNonconformance[]    @relation("ProductionNonconformanceUpdater")
  resolvedProductionNonconformances   ProductionNonconformance[]    @relation("ProductionNonconformanceResolver")
  createdProductionPaperReels         ProductionPaperReel[]         @relation("ProductionPaperReelCreator")
  createdProductionReelMovements      ProductionReelMovement[]      @relation("ProductionReelMovementCreator")
  createdProductionWarehousePallets   ProductionWarehousePallet[]   @relation("ProductionWarehousePalletCreator")
  createdProductionDispatches         ProductionDispatch[]          @relation("ProductionDispatchCreator")
  createdProductionInvoices           ProductionInvoice[]           @relation("ProductionInvoiceCreator")
  createdProductionInvoicePayments    ProductionInvoicePayment[]    @relation("ProductionInvoicePaymentCreator")
  createdProductionCreditNotes        ProductionCreditNote[]        @relation("ProductionCreditNoteCreator")
  createdProductionQuotes             ProductionQuote[]             @relation("ProductionQuoteCreator")
  updatedProductionQuotes             ProductionQuote[]             @relation("ProductionQuoteUpdater")
  approvedProductionQuotes            ProductionQuote[]             @relation("ProductionQuoteApprover")
  convertedProductionQuotes           ProductionQuote[]             @relation("ProductionQuoteConverter")
  createdProductionMaterials          ProductionMaterial[]          @relation("ProductionMaterialCreator")
  createdProductionSuppliers          ProductionSupplier[]          @relation("ProductionSupplierCreator")
  createdProductionPurchaseOrders     ProductionPurchaseOrder[]     @relation("ProductionPurchaseOrderCreator")
  createdProductionStockMovements     ProductionStockMovement[]     @relation("ProductionStockMovementCreator")
  createdProductionJobFlags           ProductionJobFlag[]           @relation("ProductionJobFlagCreator")
  resolvedProductionJobFlags          ProductionJobFlag[]           @relation("ProductionJobFlagResolver")
  createdProductionTooling            ProductionTooling[]           @relation("ProductionToolingCreator")
  createdProductionToolingEvents      ProductionToolingEvent[]      @relation("ProductionToolingEventCreator")
  createdProductionMachines           ProductionMachine[]           @relation("ProductionMachineCreator")
  createdProductionMaintenancePlans   ProductionMaintenancePlan[]   @relation("ProductionMaintenancePlanCreator")
  createdProductionMaintenanceTickets ProductionMaintenanceTicket[] @relation("ProductionMaintenanceTicketCreator")
  closedProductionMaintenanceTickets  ProductionMaintenanceTicket[] @relation("ProductionMaintenanceTicketCloser")
  issuedProductionMaintenanceParts    ProductionMaintenancePart[]   @relation("ProductionMaintenancePartIssuer")
  createdProductionEmployees          ProductionEmployee[]          @relation("ProductionEmployeeCreator")
  createdProductionRosterShifts       ProductionRosterShift[]       @relation("ProductionRosterShiftCreator")
  createdProductionAttendances        ProductionAttendance[]        @relation("ProductionAttendanceCreator")
  createdProductionLeaveRequests      ProductionLeaveRequest[]      @relation("ProductionLeaveRequestCreator")
  reviewedProductionLeaveRequests     ProductionLeaveRequest[]      @relation("ProductionLeaveRequestReviewer")
  createdProductionSafetyTrainings    ProductionSafetyTraining[]    @relation("ProductionSafetyTrainingCreator")
  createdProductionSafetyIncidents    ProductionSafetyIncident[]    @relation("ProductionSafetyIncidentCreator")
  closedProductionSafetyIncidents     ProductionSafetyIncident[]    @relation("ProductionSafetyIncidentCloser")
  createdProductionPayrollRuns        ProductionPayrollRun[]        @relation("ProductionPayrollRunCreator")
  finalizedProductionPayrollRuns      ProductionPayrollRun[]        @relation("ProductionPayrollRunFinalizer")
  uploadedProductionFiles             ProductionAttachment[]        @relation("ProductionAttachmentUploader")
}

model Company {
  id            String               @id @default(cuid())
  name          String
  country       String
  contactEmail  String
  contactPhone  String               @default("")
  address       String               @default("")
  timezone      String               @default("Africa/Nairobi")
  currency      String               @default("KES")
  logoUrl       String?
  premiumAccessGranted Boolean        @default(false)
  trialEndsAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   CompanyMembership[]
  invitations   CompanyInvitation[]
  keylineBookmarks KeylineBookmark[]
  subscriptions Subscription[]
  billingCheckouts BillingCheckout[]
  billingPayments BillingPayment[]

  @@index([name])
}

model CompanyMembership {
  id        String   @id @default(cuid())
  companyId String
  userId    String   @unique
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, role])
}

model CompanyInvitation {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  role            String    @default("MEMBER")
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("CompanyInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([companyId, email, createdAt])
  @@index([expiresAt, acceptedAt])
}

model AccessRole {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  description  String           @default("")
  permissions  String[]         @default([])
  isSuperAdmin Boolean          @default(false)
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignments  UserAccessRole[]

  @@index([name])
}

model UserAccessRole {
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime   @default(now())
  user             User       @relation("AccessRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role             AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?      @relation("AccessRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model EmailCampaign {
  id              String     @id @default(cuid())
  audience        String
  subject         String
  heading         String
  message         String
  createdByUserId String
  createdAt       DateTime   @default(now())
  emailJobs       EmailJob[]
}

model EmailJob {
  id          String         @id @default(cuid())
  userId      String
  campaignId  String?
  kind        String
  dedupeKey   String
  scheduledAt DateTime
  status      String         @default("pending")
  attempts    Int            @default(0)
  claimedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([status, scheduledAt])
  @@index([campaignId])
}

model KeylineBookmark {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  keylineId String
  name      String
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, keylineId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model Subscription {
  id                        String    @id @default(cuid())
  userId                    String
  companyId                 String?
  providerSubscriptionId    String    @unique
  providerPlanId            String
  status                    String
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  providerEventCreatedAt    DateTime?
  providerSubscriptionToken String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId, status, currentPeriodEnd])
}

model BillingCheckout {
  txRef                     String    @id
  userId                    String
  companyId                 String?
  planId                    String
  paymentMethod             String    @default("card")
  amount                    Int       @default(5)
  currency                  String    @default("USD")
  exchangeRate              Float?
  rateDate                  DateTime?
  phoneNumber               String?
  providerCheckoutRequestId String?   @unique
  providerMerchantRequestId String?
  createdAt                 DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId, createdAt])
}

model BillingPayment {
  id                    String    @id @default(cuid())
  userId                String
  companyId             String?
  provider              String
  providerTransactionId String    @unique
  reference             String?
  paymentMethod         String
  status                String
  amount                Int
  currency              String
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, paidAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOtpChallenge {
  email                       String    @id
  codeHash                    String
  expiresAt                   DateTime
  sentAt                      DateTime
  attempts                    Int       @default(0)
  failedSignInAttempts        Int       @default(0)
  failedSignInWindowStartedAt DateTime?
  requestWindowStartedAt      DateTime
  requestsInWindow            Int       @default(1)
  consumedAt                  DateTime?

  @@index([expiresAt])
}

model EmailOtpRateLimit {
  key             String   @id
  windowStartedAt DateTime
  requests        Int      @default(1)

  @@index([windowStartedAt])
}

model ProductionNotification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String    @default("global-production")
  jobId       String
  jobNo       String
  title       String
  message     String
  href        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
}

model ProductionPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductionEmployee {
  id                       String                     @id @default(cuid())
  workspaceId              String                     @default("global-production")
  createdByUserId          String?
  employeeNo               String
  name                     String
  department               String
  jobTitle                 String
  monthlyBasicSalary       Int                        @default(0)
  monthlyTaxableAllowances Int                        @default(0)
  payrollConfiguredAt      DateTime?
  status                   String                     @default("ACTIVE")
  hiredAt                  DateTime
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  createdBy                User?                      @relation("ProductionEmployeeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shifts                   ProductionRosterShift[]
  leaveRequests            ProductionLeaveRequest[]
  safetyTrainings          ProductionSafetyTraining[]
  safetyIncidents          ProductionSafetyIncident[]
  payrollLines             ProductionPayrollLine[]

  @@unique([workspaceId, employeeNo])
  @@index([workspaceId, status, name])
}

model ProductionPayrollRun {
  id              String                  @id @default(cuid())
  workspaceId     String                  @default("global-production")
  period          String
  createdByUserId String?
  finalizedByUserId String?
  rulesVersion    String
  statutoryRules  Json
  status          String                  @default("DRAFT")
  createdAt       DateTime                @default(now())
  finalizedAt     DateTime?
  createdBy       User?                   @relation("ProductionPayrollRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy     User?                   @relation("ProductionPayrollRunFinalizer", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  lines           ProductionPayrollLine[]

  @@unique([workspaceId, period])
  @@index([workspaceId, createdAt])
}

model ProductionPayrollLine {
  id                  String               @id @default(cuid())
  payrollRunId        String
  employeeId          String?
  employeeNo          String
  employeeName        String
  department          String
  basicSalary         Int
  taxableAllowances   Int
  grossPay            Int
  nssfEmployee        Int
  nssfEmployer        Int
  shif                Int
  housingLevyEmployee Int
  housingLevyEmployer Int
  taxablePay          Int
  paye                Int
  netPay              Int
  createdAt           DateTime             @default(now())
  payrollRun          ProductionPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee            ProductionEmployee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model ProductionRosterShift {
  id              String                @id @default(cuid())
  workspaceId     String                @default("global-production")
  employeeId      String
  createdByUserId String?
  shiftName       String
  workCenter      String
  startsAt        DateTime
  endsAt          DateTime
  breakMinutes    Int                   @default(0)
  status          String                @default("PLANNED")
  notes           String                @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  employee        ProductionEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("ProductionRosterShiftCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendance      ProductionAttendance?

  @@index([workspaceId, startsAt, status])
  @@index([employeeId, startsAt])
}

model ProductionAttendance {
  id              String                @id @default(cuid())
  workspaceId     String                @default("global-production")
  rosterShiftId   String                @unique
  createdByUserId String?
  clockedInAt     DateTime
  clockedOutAt    DateTime?
  overtimeMinutes Int                   @default(0)
  notes           String                @default("")
  recordedAt      DateTime              @default(now())
  rosterShift     ProductionRosterShift @relation(fields: [rosterShiftId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("ProductionAttendanceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clockedInAt])
}

model ProductionLeaveRequest {
  id               String             @id @default(cuid())
  workspaceId      String             @default("global-production")
  employeeId       String
  createdByUserId  String?
  reviewedByUserId String?
  leaveType        String
  startsAt         DateTime
  endsAt           DateTime
  reason           String
  status           String             @default("PENDING")
  reviewNotes      String             @default("")
  createdAt        DateTime           @default(now())
  reviewedAt       DateTime?
  employee         ProductionEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy        User?              @relation("ProductionLeaveRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?              @relation("ProductionLeaveRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, startsAt])
  @@index([employeeId, startsAt, endsAt])
}

model ProductionSafetyTraining {
  id              String             @id @default(cuid())
  workspaceId     String             @default("global-production")
  employeeId      String
  createdByUserId String?
  trainingName    String
  provider        String             @default("")
  completedAt     DateTime
  expiresAt       DateTime?
  notes           String             @default("")
  createdAt       DateTime           @default(now())
  employee        ProductionEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation("ProductionSafetyTrainingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, expiresAt])
  @@index([employeeId, completedAt])
}

model ProductionSafetyIncident {
  id                 String              @id @default(cuid())
  workspaceId        String              @default("global-production")
  employeeId         String?
  createdByUserId    String?
  closedByUserId     String?
  incidentType       String
  severity           String
  status             String              @default("OPEN")
  title              String
  occurredAt         DateTime
  location           String              @default("")
  description        String
  immediateAction    String              @default("")
  investigationNotes String              @default("")
  correctiveAction   String              @default("")
  closedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  employee           ProductionEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("ProductionSafetyIncidentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  closedBy           User?               @relation("ProductionSafetyIncidentCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, occurredAt])
  @@index([employeeId, occurredAt])
}

model ProductionJob {
  id                 String                        @id @default(cuid())
  workspaceId        String                        @default("global-production")
  createdByUserId    String?
  quoteId            String?
  data               Json                          @default("{}")
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  createdBy          User?                         @relation("ProductionJobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachments        ProductionAttachment[]
  flag               ProductionJobFlag?
  operationSchedules ProductionOperationSchedule[]
  stockMovements     ProductionStockMovement[]
  qualityInspections ProductionQualityInspection[]
  nonconformances    ProductionNonconformance[]
  reelMovements      ProductionReelMovement[]
  warehousePallets   ProductionWarehousePallet[]
  dispatches         ProductionDispatch[]
  invoices           ProductionInvoice[]
  toolingEvents      ProductionToolingEvent[]
  maintenanceTickets ProductionMaintenanceTicket[]
  quote              ProductionQuote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt])
  @@index([quoteId])
}

model ProductionOperationSchedule {
  id                 String                        @id @default(cuid())
  workspaceId        String                        @default("global-production")
  jobId              String
  createdByUserId    String?
  operation          String
  workCenter         String
  machineId          String?
  scheduledStartAt   DateTime
  scheduledEndAt     DateTime
  plannedQty         Int
  status             String                        @default("PLANNED")
  notes              String                        @default("")
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  job                ProductionJob                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy          User?                         @relation("ProductionOperationScheduleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  machine            ProductionMachine?            @relation(fields: [machineId], references: [id], onDelete: SetNull)
  runs               ProductionOperationRun[]
  qualityInspections ProductionQualityInspection[]
  maintenanceTickets ProductionMaintenanceTicket[]

  @@unique([jobId, operation])
  @@index([workspaceId, scheduledStartAt])
  @@index([workspaceId, workCenter, scheduledStartAt])
  @@index([machineId, scheduledStartAt])
}

model ProductionOperationRun {
  id              String                      @id @default(cuid())
  workspaceId     String                      @default("global-production")
  scheduleId      String
  createdByUserId String?
  goodQty         Int
  rejectedQty     Int
  notes           String                      @default("")
  recordedAt      DateTime                    @default(now())
  schedule        ProductionOperationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdBy       User?                       @relation("ProductionOperationRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, recordedAt])
  @@index([scheduleId, recordedAt])
}

model ProductionQualityInspection {
  id              String                       @id @default(cuid())
  inspectionNo    String                       @unique
  workspaceId     String                       @default("global-production")
  jobId           String
  scheduleId      String?
  createdByUserId String?
  inspectionType  String
  sampleQty       Int
  rejectedQty     Int
  result          String
  checks          Json                         @default("[]")
  notes           String                       @default("")
  inspectedAt     DateTime                     @default(now())
  job             ProductionJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  schedule        ProductionOperationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdBy       User?                        @relation("ProductionQualityInspectionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  nonconformances ProductionNonconformance[]

  @@index([workspaceId, inspectedAt])
  @@index([workspaceId, result])
  @@index([jobId, inspectedAt])
  @@index([scheduleId])
}

model ProductionNonconformance {
  id               String                       @id @default(cuid())
  ncrNo            String                       @unique
  workspaceId      String                       @default("global-production")
  jobId            String
  inspectionId     String?
  createdByUserId  String?
  updatedByUserId  String?
  resolvedByUserId String?
  description      String
  severity         String
  affectedQty      Int                          @default(0)
  disposition      String                       @default("PENDING")
  status           String                       @default("OPEN")
  rootCause        String                       @default("")
  correctiveAction String                       @default("")
  resolutionNotes  String                       @default("")
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  closedAt         DateTime?
  job              ProductionJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspection       ProductionQualityInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  createdBy        User?                        @relation("ProductionNonconformanceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?                        @relation("ProductionNonconformanceUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  resolvedBy       User?                        @relation("ProductionNonconformanceResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([jobId, createdAt])
  @@index([inspectionId])
}

model ProductionTooling {
  id              String                   @id @default(cuid())
  workspaceId     String                   @default("global-production")
  createdByUserId String?
  customerId      String?
  toolNo          String
  name            String
  category        String
  ownerType       String                   @default("COMPANY")
  storageLocation String                   @default("")
  status          String                   @default("AVAILABLE")
  usageCount      Int                      @default(0)
  wearNotes       String                   @default("")
  notes           String                   @default("")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdBy       User?                    @relation("ProductionToolingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customer        ProductionCustomer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  events          ProductionToolingEvent[]

  @@unique([workspaceId, toolNo])
  @@index([workspaceId, category, status])
  @@index([customerId])
}

model ProductionToolingEvent {
  id              String            @id @default(cuid())
  workspaceId     String            @default("global-production")
  toolingId       String
  createdByUserId String?
  jobId           String?
  eventType       String
  description     String
  createdAt       DateTime          @default(now())
  tooling         ProductionTooling @relation(fields: [toolingId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("ProductionToolingEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  job             ProductionJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([toolingId, createdAt])
  @@index([jobId])
}

model ProductionMachine {
  id                 String                        @id @default(cuid())
  workspaceId        String                        @default("global-production")
  createdByUserId    String?
  machineNo          String
  name               String
  machineType        String
  workCenter         String
  location           String                        @default("")
  status             String                        @default("ACTIVE")
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  createdBy          User?                         @relation("ProductionMachineCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  operationSchedules ProductionOperationSchedule[]
  plans              ProductionMaintenancePlan[]
  tickets            ProductionMaintenanceTicket[]

  @@unique([workspaceId, machineNo])
  @@index([workspaceId, workCenter, status])
}

model ProductionMaintenancePlan {
  id              String                        @id @default(cuid())
  workspaceId     String                        @default("global-production")
  machineId       String
  createdByUserId String?
  taskName        String
  intervalDays    Int
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  instructions    String                        @default("")
  active          Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  machine         ProductionMachine             @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdBy       User?                         @relation("ProductionMaintenancePlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tickets         ProductionMaintenanceTicket[]

  @@index([workspaceId, active, nextDueAt])
  @@index([machineId, active, nextDueAt])
}

model ProductionMaintenanceTicket {
  id                  String                       @id @default(cuid())
  workspaceId         String                       @default("global-production")
  machineId           String
  planId              String?
  jobId               String?
  operationScheduleId String?
  createdByUserId     String?
  closedByUserId      String?
  ticketNo            String
  ticketType          String
  priority            String                       @default("MEDIUM")
  status              String                       @default("OPEN")
  description         String
  resolution          String                       @default("")
  downtimeMinutes     Int                          @default(0)
  openedAt            DateTime                     @default(now())
  closedAt            DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  machine             ProductionMachine            @relation(fields: [machineId], references: [id], onDelete: Cascade)
  plan                ProductionMaintenancePlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  job                 ProductionJob?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  operationSchedule   ProductionOperationSchedule? @relation(fields: [operationScheduleId], references: [id], onDelete: SetNull)
  createdBy           User?                        @relation("ProductionMaintenanceTicketCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  closedBy            User?                        @relation("ProductionMaintenanceTicketCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  parts               ProductionMaintenancePart[]

  @@unique([workspaceId, ticketNo])
  @@index([workspaceId, status, openedAt])
  @@index([machineId, openedAt])
  @@index([planId])
  @@index([jobId])
  @@index([operationScheduleId])
}

model ProductionMaintenancePart {
  id              String                      @id @default(cuid())
  ticketId        String
  materialId      String
  stockMovementId String                      @unique
  issuedByUserId  String?
  quantity        Decimal                     @db.Decimal(14, 3)
  issuedAt        DateTime                    @default(now())
  ticket          ProductionMaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  material        ProductionMaterial          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  stockMovement   ProductionStockMovement     @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  issuedBy        User?                       @relation("ProductionMaintenancePartIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, issuedAt])
  @@index([materialId, issuedAt])
}

model ProductionMaterial {
  id                 String                        @id @default(cuid())
  workspaceId        String                        @default("global-production")
  createdByUserId    String?
  code               String
  name               String
  category           String
  unit               String
  reorderPoint       Decimal                       @default(0) @db.Decimal(14, 3)
  active             Boolean                       @default(true)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  createdBy          User?                         @relation("ProductionMaterialCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  purchaseOrderLines ProductionPurchaseOrderLine[]
  stockMovements     ProductionStockMovement[]
  paperReels         ProductionPaperReel[]
  maintenanceParts   ProductionMaintenancePart[]

  @@unique([workspaceId, code])
  @@index([workspaceId, name])
}

model ProductionSupplier {
  id              String                    @id @default(cuid())
  workspaceId     String                    @default("global-production")
  createdByUserId String?
  code            String
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdBy       User?                     @relation("ProductionSupplierCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  purchaseOrders  ProductionPurchaseOrder[]
  paperReels      ProductionPaperReel[]

  @@unique([workspaceId, code])
  @@index([workspaceId, name])
}

model ProductionPurchaseOrder {
  id              String                        @id @default(cuid())
  workspaceId     String                        @default("global-production")
  supplierId      String
  createdByUserId String?
  orderNo         String
  status          String                        @default("OPEN")
  expectedAt      DateTime?
  notes           String                        @default("")
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  supplier        ProductionSupplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy       User?                         @relation("ProductionPurchaseOrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines           ProductionPurchaseOrderLine[]

  @@unique([workspaceId, orderNo])
  @@index([workspaceId, status, createdAt])
  @@index([supplierId, createdAt])
}

model ProductionPurchaseOrderLine {
  id              String                    @id @default(cuid())
  purchaseOrderId String
  materialId      String
  orderedQty      Decimal                   @db.Decimal(14, 3)
  receivedQty     Decimal                   @default(0) @db.Decimal(14, 3)
  purchaseOrder   ProductionPurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material        ProductionMaterial        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  stockMovements  ProductionStockMovement[]
  paperReels      ProductionPaperReel[]

  @@unique([purchaseOrderId, materialId])
  @@index([materialId])
}

model ProductionStockMovement {
  id                  String                       @id @default(cuid())
  workspaceId         String                       @default("global-production")
  materialId          String
  jobId               String?
  purchaseOrderLineId String?
  createdByUserId     String?
  type                String
  quantity            Decimal                      @db.Decimal(14, 3)
  reference           String?
  notes               String                       @default("")
  createdAt           DateTime                     @default(now())
  material            ProductionMaterial           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  job                 ProductionJob?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  purchaseOrderLine   ProductionPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  createdBy           User?                        @relation("ProductionStockMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  maintenancePart     ProductionMaintenancePart?

  @@index([workspaceId, materialId, createdAt])
  @@index([workspaceId, jobId, createdAt])
  @@index([purchaseOrderLineId])
}

model ProductionPaperReel {
  id                  String                       @id @default(cuid())
  workspaceId         String                       @default("global-production")
  materialId          String
  supplierId          String?
  purchaseOrderLineId String?
  parentReelId        String?
  createdByUserId     String?
  reelNo              String
  barcode             String                       @unique
  batchNo             String                       @default("")
  widthMm             Decimal                      @db.Decimal(10, 2)
  gsm                 Decimal                      @db.Decimal(10, 3)
  receivedWeightKg    Decimal                      @db.Decimal(14, 3)
  availableWeightKg   Decimal                      @db.Decimal(14, 3)
  status              String                       @default("AVAILABLE")
  storageLocation     String                       @default("")
  notes               String                       @default("")
  receivedAt          DateTime                     @default(now())
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  material            ProductionMaterial           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  supplier            ProductionSupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderLine   ProductionPurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  parentReel          ProductionPaperReel?         @relation("ProductionReelAncestry", fields: [parentReelId], references: [id], onDelete: SetNull)
  childReels          ProductionPaperReel[]        @relation("ProductionReelAncestry")
  createdBy           User?                        @relation("ProductionPaperReelCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  movements           ProductionReelMovement[]     @relation("ProductionReelMovementReel")
  relatedMovements    ProductionReelMovement[]     @relation("ProductionReelMovementRelatedReel")

  @@unique([workspaceId, reelNo])
  @@index([workspaceId, status, createdAt])
  @@index([materialId, batchNo])
  @@index([supplierId, receivedAt])
  @@index([purchaseOrderLineId])
  @@index([parentReelId])
}

model ProductionReelMovement {
  id              String               @id @default(cuid())
  workspaceId     String               @default("global-production")
  reelId          String
  relatedReelId   String?
  jobId           String?
  createdByUserId String?
  type            String
  deltaKg         Decimal              @db.Decimal(14, 3)
  notes           String               @default("")
  createdAt       DateTime             @default(now())
  reel            ProductionPaperReel  @relation("ProductionReelMovementReel", fields: [reelId], references: [id], onDelete: Cascade)
  relatedReel     ProductionPaperReel? @relation("ProductionReelMovementRelatedReel", fields: [relatedReelId], references: [id], onDelete: SetNull)
  job             ProductionJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("ProductionReelMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([reelId, createdAt])
  @@index([workspaceId, jobId, createdAt])
  @@index([relatedReelId])
}

model ProductionWarehousePallet {
  id                String                   @id @default(cuid())
  workspaceId       String                   @default("global-production")
  jobId             String
  createdByUserId   String?
  palletNo          String
  quantityReceived  Int
  quantityAvailable Int
  location          String
  notes             String                   @default("")
  receivedAt        DateTime                 @default(now())
  job               ProductionJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("ProductionWarehousePalletCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dispatchLines     ProductionDispatchLine[]

  @@unique([workspaceId, palletNo])
  @@index([workspaceId, location, receivedAt])
  @@index([jobId, receivedAt])
}

model ProductionDispatch {
  id                  String                   @id @default(cuid())
  workspaceId         String                   @default("global-production")
  jobId               String
  createdByUserId     String?
  dispatchNo          String
  deliveryNoteNo      String
  status              String                   @default("DISPATCHED")
  vehicleRegistration String
  driverName          String
  route               String                   @default("")
  notes               String                   @default("")
  dispatchedAt        DateTime                 @default(now())
  deliveredAt         DateTime?
  receivedBy          String                   @default("")
  deliveryNotes       String                   @default("")
  job                 ProductionJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy           User?                    @relation("ProductionDispatchCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines               ProductionDispatchLine[]
  invoice             ProductionInvoice?

  @@unique([workspaceId, dispatchNo])
  @@unique([deliveryNoteNo])
  @@index([workspaceId, status, dispatchedAt])
  @@index([jobId, dispatchedAt])
}

model ProductionDispatchLine {
  id         String                    @id @default(cuid())
  dispatchId String
  palletId   String
  quantity   Int
  dispatch   ProductionDispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  pallet     ProductionWarehousePallet @relation(fields: [palletId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, palletId])
  @@index([palletId])
}

model ProductionInvoice {
  id              String                     @id @default(cuid())
  workspaceId     String                     @default("global-production")
  jobId           String
  dispatchId      String                     @unique
  customerId      String?
  createdByUserId String?
  invoiceNo       String
  customerName    String
  jobNo           String
  customerPO      String                     @default("")
  status          String                     @default("OPEN")
  currency        String                     @default("KES")
  quantity        Int
  unitPrice       Decimal                    @db.Decimal(14, 4)
  totalAmount     Decimal                    @db.Decimal(14, 2)
  amountPaid      Decimal                    @default(0) @db.Decimal(14, 2)
  amountCredited  Decimal                    @default(0) @db.Decimal(14, 2)
  issuedAt        DateTime                   @default(now())
  dueAt           DateTime
  notes           String                     @default("")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  job             ProductionJob              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  dispatch        ProductionDispatch         @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  customer        ProductionCustomer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy       User?                      @relation("ProductionInvoiceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments        ProductionInvoicePayment[]
  creditNotes     ProductionCreditNote[]

  @@unique([workspaceId, invoiceNo])
  @@index([workspaceId, status, dueAt])
  @@index([customerId, issuedAt])
  @@index([jobId, issuedAt])
}

model ProductionInvoicePayment {
  id              String            @id @default(cuid())
  invoiceId       String
  createdByUserId String?
  paymentNo       String            @unique
  amount          Decimal           @db.Decimal(14, 2)
  method          String
  reference       String            @default("")
  notes           String            @default("")
  paidAt          DateTime          @default(now())
  createdAt       DateTime          @default(now())
  invoice         ProductionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("ProductionInvoicePaymentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, paidAt])
}

model ProductionCreditNote {
  id              String            @id @default(cuid())
  invoiceId       String
  createdByUserId String?
  creditNoteNo    String            @unique
  amount          Decimal           @db.Decimal(14, 2)
  reason          String
  notes           String            @default("")
  issuedAt        DateTime          @default(now())
  createdAt       DateTime          @default(now())
  invoice         ProductionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("ProductionCreditNoteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, issuedAt])
}

model ProductionItem {
  id              String                @id @default(cuid())
  workspaceId     String                @default("global-production")
  createdByUserId String?
  customerId      String?
  itemCode        String
  name            String
  boxType         String
  topLiner        String
  medium          String
  bottomLiner     String
  length          String
  width           String
  height          String
  unit            String                @default("mm")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       User?                 @relation("ProductionItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customer        ProductionCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteLines      ProductionQuoteLine[]
  artwork         ProductionAttachment[]

  @@unique([workspaceId, itemCode])
  @@index([workspaceId, name])
  @@index([customerId])
}

model ProductionCustomer {
  id              String              @id @default(cuid())
  workspaceId     String              @default("global-production")
  createdByUserId String?
  name            String
  kraPin          String?
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User?               @relation("ProductionCustomerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           ProductionItem[]
  quotes          ProductionQuote[]
  invoices        ProductionInvoice[]
  tooling         ProductionTooling[]

  @@index([workspaceId, name])
  @@index([name])
}

model ProductionQuote {
  id                String                @id @default(cuid())
  workspaceId       String                @default("global-production")
  customerId        String
  quoteNo           String
  version           Int                   @default(1)
  status            String                @default("DRAFT")
  currency          String                @default("KES")
  validUntil        DateTime
  inquiryReference  String                @default("")
  notes             String                @default("")
  rejectionReason   String                @default("")
  totalCost         Decimal               @db.Decimal(14, 2)
  totalPrice        Decimal               @db.Decimal(14, 2)
  createdByUserId   String?
  updatedByUserId   String?
  approvedByUserId  String?
  convertedByUserId String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  convertedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  customer          ProductionCustomer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy         User?                 @relation("ProductionQuoteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?                 @relation("ProductionQuoteUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?                 @relation("ProductionQuoteApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  convertedBy       User?                 @relation("ProductionQuoteConverter", fields: [convertedByUserId], references: [id], onDelete: SetNull)
  lines             ProductionQuoteLine[]
  jobs              ProductionJob[]

  @@unique([workspaceId, quoteNo, version])
  @@index([workspaceId, status, createdAt])
  @@index([customerId, createdAt])
}

model ProductionQuoteLine {
  id                  String          @id @default(cuid())
  quoteId             String
  itemId              String?
  itemCode            String
  itemName            String
  boxType             String
  topLiner            String
  medium              String
  bottomLiner         String
  length              String
  width               String
  height              String
  unit                String
  quantity            Int
  boardAreaM2         Decimal         @db.Decimal(10, 4)
  boardGsm            Decimal         @db.Decimal(10, 3)
  paperCostPerKg      Decimal         @db.Decimal(14, 4)
  trimWastePercent    Decimal         @db.Decimal(7, 3)
  conversionCost      Decimal         @db.Decimal(14, 4)
  consumablesCost     Decimal         @db.Decimal(14, 4)
  marginPercent       Decimal         @db.Decimal(7, 3)
  materialCostPerUnit Decimal         @db.Decimal(14, 4)
  unitCost            Decimal         @db.Decimal(14, 4)
  unitPrice           Decimal         @db.Decimal(14, 4)
  lineCostTotal       Decimal         @db.Decimal(14, 2)
  linePriceTotal      Decimal         @db.Decimal(14, 2)
  quote               ProductionQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item                ProductionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([itemId])
}

model ProductionJobFlag {
  id               String        @id @default(cuid())
  jobId            String        @unique
  createdByUserId  String?
  reason           String
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  job              ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy        User?         @relation("ProductionJobFlagCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy       User?         @relation("ProductionJobFlagResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
}

model ProductionAttachment {
  id               String          @id @default(cuid())
  jobId            String
  itemId           String?
  uploadedByUserId String?
  pathname         String          @unique
  originalName     String
  contentType      String
  size             Int
  version          Int             @default(1)
  revisionComment  String          @default("")
  createdAt        DateTime        @default(now())
  job              ProductionJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item             ProductionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  uploadedBy       User?           @relation("ProductionAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@unique([itemId, version])
  @@index([jobId, createdAt])
  @@index([itemId, createdAt])
}
