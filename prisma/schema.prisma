generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id                       String            @id @default(cuid())
  name                     String?
  companyName              String?
  role                     String?
  contact                  String?
  address                  String?
  email                    String?           @unique
  emailVerified            DateTime?
  image                    String?
  premiumAccessGranted     Boolean           @default(false)
  trialEndsAt              DateTime?
  marketingEmailsEnabled   Boolean           @default(true)
  marketingEmailsUpdatedAt DateTime?
  accounts                 Account[]
  sessions                 Session[]
  subscriptions            Subscription[]
  billingCheckouts         BillingCheckout[]
  billingPayments          BillingPayment[]
  keylineBookmarks         KeylineBookmark[]
  emailJobs                EmailJob[]
}

model EmailCampaign {
  id              String     @id @default(cuid())
  audience        String
  subject         String
  heading         String
  message         String
  createdByUserId String
  createdAt       DateTime   @default(now())
  emailJobs       EmailJob[]
}

model EmailJob {
  id          String         @id @default(cuid())
  userId      String
  campaignId  String?
  kind        String
  dedupeKey   String
  scheduledAt DateTime
  status      String         @default("pending")
  attempts    Int            @default(0)
  claimedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([status, scheduledAt])
  @@index([campaignId])
}

model KeylineBookmark {
  id        String   @id @default(cuid())
  userId    String
  keylineId String
  name      String
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keylineId])
  @@index([userId, createdAt])
}

model Subscription {
  id                        String    @id @default(cuid())
  userId                    String
  providerSubscriptionId    String    @unique
  providerPlanId            String
  status                    String
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean   @default(false)
  providerEventCreatedAt    DateTime?
  providerSubscriptionToken String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingCheckout {
  txRef                     String    @id
  userId                    String
  planId                    String
  paymentMethod             String    @default("card")
  amount                    Int       @default(5)
  currency                  String    @default("USD")
  exchangeRate              Float?
  rateDate                  DateTime?
  phoneNumber               String?
  providerCheckoutRequestId String?   @unique
  providerMerchantRequestId String?
  createdAt                 DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingPayment {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  providerTransactionId String    @unique
  reference             String?
  paymentMethod         String
  status                String
  amount                Int
  currency              String
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, paidAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
