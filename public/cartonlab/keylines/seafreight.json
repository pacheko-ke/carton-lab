{
  "id": "seafreight",
  "name": "Kongoni - Sea Freight Box",
  "title": "SEA FREIGHT BOX KEYLINE",
  "inputs": [
    {
      "id": "glue",
      "label": "Glue flap width",
      "default": 145,
      "min": 0
    },
    {
      "id": "gap",
      "label": "Flap clearance",
      "default": 5,
      "min": 0
    }
  ],
  "params": {
    "refL": "1000",
    "refW": "385",
    "refH": "250",
    "kL": "L / refL",
    "kW": "W / refW",
    "kH": "H / refH",
    "pr": "min(kW, kH)",
    "Lf": "L + 2*gap",
    "Wf": "W + 2*gap",
    "xl": "glue + H",
    "xr": "xl + Lf",
    "xwr": "xr + H",
    "bl": "xwr + glue",
    "bw": "Wf + 2*H",
    "yf": "H + Wf",
    "yt": "H + gap",
    "yw": "yf - gap",
    "ef": "(W - gap) / 2",
    "eh": "H - gap",
    "xcl": "xl + gap",
    "xcr": "xr - gap",
    "xc": "(xl + xr) / 2",
    "efl": "xcl - ef",
    "efr": "xcr + ef",
    "earR": "20",
    "efW": "75*kW",
    "efH": "105*kH",
    "efD": "30*kH",
    "efR": "18.8*pr",
    "efcL": "xcl - ef / 2",
    "efcR": "xcr + ef / 2",
    "efY": "(H - efH) / 2",
    "whW": "55*kW",
    "whH": "80*kH",
    "whR": "14*pr",
    "wy1": "H + ef / 2",
    "wy2": "yf - ef / 2",
    "wa1": "wy1 - whW / 2",
    "wb1": "wy1 + whW / 2",
    "wa2": "wy2 - whW / 2",
    "wb2": "wy2 + whW / 2",
    "nD": "25",
    "nRx": "12.2",
    "nRy": "13",
    "strapR": "15*kH",
    "strapY": "165*kH",
    "tongueH": "105*kH",
    "step": "250*kL",
    "uW": "2*strapR",
    "uD": "30*kH",
    "uRx": "0.25*uW",
    "uRy": "0.33*uD",
    "tW": "595*kL",
    "slitW": "1.8",
    "tl": "xc - tW / 2",
    "tr": "xc + tW / 2",
    "pitch": "170.46*kL",
    "sx1": "xc - 2.5*pitch",
    "sx2": "xc - 1.5*pitch",
    "sx3": "xc - 0.5*pitch",
    "sx4": "xc + 0.5*pitch",
    "sx5": "xc + 1.5*pitch",
    "sx6": "xc + 2.5*pitch",
    "sy1": "(H + yf) / 2 - 92.9*kW",
    "sy2": "(H + yf) / 2 + 92.9*kW"
  },
  "require": [
    {
      "expr": "gap < H",
      "message": "The flap clearance is too large for this height."
    },
    {
      "expr": "2*gap < W",
      "message": "The flap clearance is too large for this width."
    },
    {
      "expr": "glue > nD",
      "message": "The glue flap is too narrow for the finger notch."
    },
    {
      "expr": "efW < ef",
      "message": "The end flap hole is too wide for this width."
    },
    {
      "expr": "efH < H",
      "message": "The end flap hole is too tall for this height."
    },
    {
      "expr": "tW / 2 > step + strapR",
      "message": "The strap tongue is too short for the strap holes."
    },
    {
      "expr": "2*tongueH < H",
      "message": "The strap tongue is too deep for this height."
    },
    {
      "expr": "2.5*pitch + 30 < L / 2",
      "message": "The floor slots do not fit this length."
    }
  ],
