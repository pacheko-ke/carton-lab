AUTH_SECRET=
AUTH_GOOGLE_ID=<Google OAuth client ID>
AUTH_GOOGLE_SECRET=<Google OAuth client secret>
# Email-code authentication is disabled by default; set true to enable it.
EMAIL_OTP_ENABLED=false
POSTGRES_PRISMA_URL=<Pooled PostgreSQL connection string for the app>
POSTGRES_URL_NON_POOLING=<Direct PostgreSQL connection string for migrations>
# Connect a private Vercel Blob store; Vercel provides BLOB_STORE_ID and OIDC credentials.
BLOB_STORE_ID=
# Resend sends welcome emails and account/payment/subscription alerts.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PackStudio <hello@your-verified-domain.com>"
# Comma-separated verified Google account emails allowed to access /admin and receive alerts.
ADMIN_EMAILS=
# Paystack is used for recurring card subscriptions; keep keys server-side.
PAYSTACK_SECRET_KEY=<Paystack secret key>
PAYSTACK_PLAN_CODE=<Paystack plan code for $5 USD per month>
PAYSTACK_WEBHOOK_SECRET=<Paystack webhook signing secret>
# Daraja sandbox values must come from your Safaricom developer app.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=<Daraja consumer key>
DARAJA_CONSUMER_SECRET=<Daraja consumer secret>
DARAJA_SHORTCODE=<Daraja business shortcode>
DARAJA_PASSKEY=<Daraja Lipa Na M-Pesa passkey>
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_URL=<public HTTPS URL ending in /api/daraja/callback>
APP_URL=http://localhost:3000
# Protects the hourly scheduled email worker; configure the same secret in Vercel.
CRON_SECRET=<long random secret>
